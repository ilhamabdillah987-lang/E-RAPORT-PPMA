rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'ilhamabdillah987@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*admin.*')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Account registry for cross-device and cross-IP username verification
    // Accessible across all networks and devices
    match /account_registry/{accountId} {
      allow read: if true;
      allow create, update: if isValidId(accountId);
      allow delete: if true;
    }

    // User profiles for cross-device synchronization
    match /users/{userId} {
      allow read, write: if true;
    }

    // School data (santri, nilai, settings, mapel, users)
    match /school_data/{dataType} {
      allow read, write: if true;
    }

    // Audit logs for data changes
    match /audit_logs/{logId} {
      allow read, write: if true;
    }
  }
}
