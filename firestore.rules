rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || request.auth.token.email == 'ilhamabdillah987@gmail.com');
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || request.auth.token.email == 'ilhamabdillah987@gmail.com');

      allow create: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && incoming().uid == request.auth.uid
        && incoming().username is string && incoming().username.size() >= 3 && incoming().username.size() <= 64
        && incoming().fullName is string && incoming().fullName.size() <= 150
        && incoming().role in ['admin', 'walikelas', 'guru'];

      allow update: if isSignedIn()
        && isValidId(userId)
        && request.auth.uid == userId
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['password', 'username', 'fullName', 'assignedClass', 'kelasAkses', 'assignedMapelIds', 'mapelAkses', 'nip', 'updatedAt']);
    }
  }
}
