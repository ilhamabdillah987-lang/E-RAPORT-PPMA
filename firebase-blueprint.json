{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and credentials for Wali Kelas, Guru, and Admin with Google Account linkage",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 64 },
        "password": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 150 },
        "email": { "type": "string", "maxLength": 120 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["admin", "walikelas", "guru"] },
        "status": { "type": "string", "enum": ["active", "suspended", "pending"] },
        "assignedClass": { "type": "string", "maxLength": 80 },
        "kelasAkses": { "type": "string", "maxLength": 80 },
        "assignedMapelIds": { "type": "array", "items": { "type": "string" } },
        "mapelAkses": { "type": "array", "items": { "type": "string" } },
        "nip": { "type": "string", "maxLength": 40 },
        "authProvider": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "fullName", "email", "role", "createdAt"]
    },
    "SchoolData": {
      "title": "SchoolData",
      "description": "Shared online application data including santri, nilai, settings, and curriculum",
      "type": "object",
      "properties": {
        "dataType": { "type": "string", "enum": ["santri", "nilai", "settings", "mapel"] },
        "data": { "type": "object" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      },
      "required": ["dataType", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "History of changes for auditability across devices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "performedBy": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["action", "performedBy", "timestamp"]
    },
    "AccountRegistry": {
      "title": "AccountRegistry",
      "description": "Universal cross-device user account lookup with salted password hash",
      "type": "object",
      "properties": {
        "username": { "type": "string", "maxLength": 64 },
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 120 },
        "fullName": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["admin", "walikelas", "guru"] },
        "passwordHash": { "type": "string", "maxLength": 128 },
        "salt": { "type": "string", "maxLength": 64 },
        "assignedClass": { "type": "string", "maxLength": 80 },
        "kelasAkses": { "type": "string", "maxLength": 80 },
        "assignedMapelIds": { "type": "array", "items": { "type": "string" } },
        "mapelAkses": { "type": "array", "items": { "type": "string" } },
        "nip": { "type": "string", "maxLength": 40 },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "authProvider": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["username", "uid", "role", "passwordHash"]
    }
  },
  "firestore": {
    "/account_registry/{accountId}": {
      "schema": "AccountRegistry",
      "description": "Cross-device account registry with salted hashed credentials"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles authenticated via Firebase Auth & Google Sign-In"
    },
    "/school_data/{dataType}": {
      "schema": "SchoolData",
      "description": "Online cloud database for Santri, Nilai, Settings, and Mapel"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Change history and sync records"
    }
  }
}
